PORT=5001

# MongoDB Atlas connection string (get this from Atlas > Database > Connect)
# Replace <username>, <password>, and cluster address with your own.
# Keep a database name (e.g. /student-housing) before the "?" so data doesn't
# default into the "test" database.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student-housing?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
FRONTEND_URL=http://localhost:5001
